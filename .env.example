# Local snapshot and web server
OCI_IAM_PLOTTER_CACHE_DIR=.iam-plotter-cache
OCI_IAM_PLOTTER_HOST=127.0.0.1
OCI_IAM_PLOTTER_PORT=8501
OCI_IAM_PLOTTER_USE_PROXY=0
OCI_CONFIG_FILE=~/.oci/config
OCI_CONFIG_PROFILE=DEFAULT
# Durable snapshot archive. Local runs use the selected OCI config principal;
# OCI Generative AI Hosted Applications use their resource principal.
OCI_IAM_PLOTTER_OBJECT_STORAGE_BUCKET=bucket_iam_plotter
OCI_IAM_PLOTTER_OBJECT_STORAGE_NAMESPACE=
OCI_IAM_PLOTTER_OBJECT_STORAGE_ENABLED=true

# Local web authentication. Username defaults to oci. When no password is set,
# start.sh generates a strong password in the owner-only password file.
OCI_IAM_PLOTTER_USERNAME=oci
# OCI_IAM_PLOTTER_PASSWORD=
OCI_IAM_PLOTTER_PASSWORD_FILE=.iam-plotter-password

# OCI Generative AI OpenAI-compatible Responses API
OCI_GENAI_PROJECT_OCID=ocid1.generativeaiproject.oc1.us-chicago-1.amaaaaaafigrwqyaszdh7vv7uymklym7vjid2dac4niv6pxokjd54hve4l7a
OCI_GENAI_MODEL_ID=xai.grok-4
OCI_GENAI_BASE_URL=https://inference.generativeai.us-chicago-1.oci.oraclecloud.com/openai/v1
OCI_GENAI_API_KEY_FILE=.oci-genai-api-key

# Prefer OCI_GENAI_API_KEY. OPENAI_API_KEY is also accepted for SDK compatibility.
# OCI_GENAI_API_KEY=
# OPENAI_API_KEY=

# Docker Compose publishes only to localhost. HOME is used to mount ~/.oci
# read-only into the container. OCI API-key paths in config should use
# ~/.oci/<filename> so they resolve inside the container.
